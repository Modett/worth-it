# Test-only environment. Loaded by `test/setup-env.ts` and `prisma.config.ts`
# when NODE_ENV=test. Values already present in the process environment win
# (this is how CI points the suite at its service containers).
# Never point DATABASE_URL here at a dev or prod database.

NODE_ENV=test
PORT=3001
LOG_LEVEL=silent

DATABASE_URL=postgresql://worthit:worthit@localhost:5432/worthit_test
DATABASE_POOL_MAX=5
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=test-jwt-secret-not-for-production-use-000000
JWT_REFRESH_SECRET=test-jwt-refresh-secret-not-for-production-0
AI_EXTRACTION_API_KEY=test-ai-extraction-key
AI_COPY_API_KEY=test-ai-copy-key
R2_ACCESS_KEY=test-r2-access-key
R2_SECRET_KEY=test-r2-secret-key
R2_BUCKET=worth-it-test

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=1000
