# Copy to `.env` and fill in real values. Every variable listed here is
# validated at boot (src/config/env.validation.ts); the app refuses to start
# if a required one is missing or malformed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL (Railway) — connection pool size is capped per replica so that
# N replicas * DATABASE_POOL_MAX stays under the Railway Postgres limit.
DATABASE_URL=postgresql://worthit:worthit@localhost:5432/worthit
DATABASE_POOL_MAX=10

# Redis (Railway) — used for caching, BullMQ queues and rate-limit counters.
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# AI providers (extraction = cheap tier, copy = occasional "why" phrasing)
AI_EXTRACTION_API_KEY=replace-me
AI_COPY_API_KEY=replace-me

# Cloudflare R2 (S3-compatible)
R2_ACCESS_KEY=replace-me
R2_SECRET_KEY=replace-me
R2_BUCKET=worth-it-dev

# Rate limiting (global default; per-route overrides live on the controllers)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
